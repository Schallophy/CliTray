<ui:FluentWindow x:Class="CliTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CliTray 管理"
        Width="1000" Height="580" MinWidth="860" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowCornerPreference="Round"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="160" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CliTray 管理"/>

        <Border Grid.Row="1" Padding="12,4"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnAdd" Content="添加" Appearance="Primary"
                                   Padding="10,4" FontSize="12.5" Margin="0,0,4,0"
                                   Click="AddItem"/>
                        <ui:Button x:Name="BtnEdit" Content="编辑" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5" Margin="0,0,4,0"
                                   Click="EditItem"/>
                        <ui:Button x:Name="BtnDelete" Content="删除" Appearance="Danger"
                                   Padding="10,4" FontSize="12.5"
                                   Click="DeleteItem"/>
                        <Border Style="{StaticResource ToolbarSeparator}"/>
                        <ui:Button x:Name="BtnStart" Content="启动" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5" Margin="0,0,4,0"
                                   Click="StartSelected"/>
                        <ui:Button x:Name="BtnStop" Content="停止" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5" Margin="0,0,4,0"
                                   Click="StopSelected"/>
                        <ui:Button x:Name="BtnRestart" Content="重启" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5"
                                   Click="RestartSelected"/>
                        <Border Style="{StaticResource ToolbarSeparator}"/>
                        <ui:Button Content="全部启动" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5" Margin="0,0,4,0"
                                   Click="StartAll"/>
                        <ui:Button Content="全部停止" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5"
                                   Click="StopAll"/>
                        <Border Style="{StaticResource ToolbarSeparator}"/>
                        <ui:Button Content="打开配置目录" Appearance="Secondary"
                                   Padding="10,4" FontSize="12.5"
                                   Click="OpenConfigFolder"/>
                    </StackPanel>
                </ScrollViewer>

                <CheckBox x:Name="SelfAutoStart" Grid.Column="1"
                          Content="本程序开机自启"
                          VerticalAlignment="Center" Margin="12,0,4,0"
                          Click="SelfAutoStartClicked"/>
            </Grid>
        </Border>

        <ui:DataGrid x:Name="ItemGrid" Grid.Row="2"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     CanUserResizeRows="False"
                     CanUserReorderColumns="False"
                     HeadersVisibility="Column"
                     SelectionMode="Single"
                     SelectionUnit="FullRow"
                     GridLinesVisibility="Horizontal"
                     RowHeight="32"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                     ColumnHeaderHeight="34"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="GridSelectionChanged"
                     MouseDoubleClick="GridMouseDoubleClick"
                     PreviewMouseRightButtonDown="GridPreviewMouseRightButtonDown"
                     ContextMenuOpening="GridContextMenuOpening">
            <ui:DataGrid.Resources>
                <ContextMenu x:Key="RowMenu" x:Shared="False">
                    <ui:MenuItem Header="启动" Click="StartSelected"/>
                    <ui:MenuItem Header="停止" Click="StopSelected"/>
                    <ui:MenuItem Header="重启" Click="RestartSelected"/>
                    <Separator/>
                    <ui:MenuItem Header="编辑" Click="EditItem"/>
                    <ui:MenuItem Header="删除" Click="DeleteItem"/>
                </ContextMenu>
            </ui:DataGrid.Resources>
            <ui:DataGrid.Columns>
                <DataGridTemplateColumn Header="自启" Width="60" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding AutoStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="名称" Width="140"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True" CanUserSort="False"/>
                <DataGridTemplateColumn Header="状态" Width="78" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource StatusText}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Width="70"
                                    Binding="{Binding PidText}"
                                    IsReadOnly="True" CanUserSort="False"/>
                <DataGridTextColumn Header="命令" Width="*" MinWidth="200"
                                    Binding="{Binding Command}"
                                    IsReadOnly="True" CanUserSort="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Command}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="工作目录" Width="240"
                                    Binding="{Binding WorkDir}"
                                    IsReadOnly="True" CanUserSort="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding WorkDir}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <GridSplitter Grid.Row="3" Height="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Cursor" Value="SizeNS"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="12,5,12,2">
                    <TextBlock x:Name="OutputTitle" Text="输出"
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center"/>
                    <ui:Button x:Name="BtnClearOutput" Content="清空"
                               Appearance="Secondary" Padding="8,1" FontSize="12"
                               HorizontalAlignment="Right" Click="ClearOutput"/>
                </Grid>

                <TextBox x:Name="OutputBox" Grid.Row="1"
                         Style="{x:Null}"
                         Margin="12,2,12,8"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="5" Padding="12,6"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}"/>
        </Border>
    </Grid>
</ui:FluentWindow>
